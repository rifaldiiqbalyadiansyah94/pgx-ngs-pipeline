manifest {
    name = 'pgx-ngs-pipeline'
    description = 'Pharmacogenomics pipeline: FASTQ to PharmCAT report'
    version = '0.1.0'
    nextflowVersion = '>=23.10.0'
}

params {
    input            = null
    fasta            = null
    pgx_positions    = null
    outdir           = "${projectDir}/results"
    pharmcat_version = '3.4.0'
}

process {
    errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'terminate' }
    maxRetries    = 2
    cache = 'lenient'

    withName: 'PREPARE_REF'   { cpus = 4;  memory = '12 GB' }
    withName: 'FASTQC'        { cpus = 2;  memory = '2 GB'  }
    withName: 'FASTP'         { cpus = 4;  memory = '4 GB'  }
    withName: 'BWA_ALIGN' { cpus = 10; memory = '12 GB' }
    withName: 'MARKDUP'       { cpus = 2;  memory = '8 GB'  }
    withName: 'GATK_CALL'     { cpus = 2;  memory = '8 GB'  }
    withName: 'RUN_PHARMCAT'  { cpus = 2;  memory = '6 GB'  }
    withName: 'MULTIQC'       { cpus = 1;  memory = '2 GB'  }
}

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    test {
        params.input  = "${projectDir}/samplesheet.test.csv"
        params.outdir = "${projectDir}/results_test"
        process {
            withName: 'PREPARE_REF'   { cpus = 2; memory = '8 GB' }
            withName: 'BWA_ALIGN' { cpus = 2; memory = '8 GB' }
            withName: 'MARKDUP'       { memory = '4 GB' }
            withName: 'GATK_CALL'     { memory = '4 GB' }
        }
    }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
